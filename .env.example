# Copy this file to .env and fill in the values.
# Do not commit .env.

# --- Supabase Postgres ---
# Project Settings → Database → Connection string.
# App runtime: Transaction pooler, port 6543.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Prisma migrations: direct connection, port 5432.
# Project Settings → Database → Direct connection.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# --- Supabase API (reception live updates) ---
# Project Settings → Data API / API keys.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Project Settings → API keys → service_role.
# Server only. Never expose this in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-string"
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app
AUTH_URL="http://localhost:3000"

# SMTP account used only for forgot-password emails.
# Port 465 usually needs SMTP_SECURE="true". Port 587 usually needs "false".
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="smtp-username"
SMTP_PASSWORD="smtp-password"
SMTP_FROM="Arrival Desk <desk@yourdomain.com>"

# First super admin created by: npx prisma db seed
SEED_SUPER_ADMIN_EMAIL="you@company.com"
SEED_SUPER_ADMIN_PASSWORD="change-this-password"

# Office clock for “today” on the reception board.
# Use an IANA city name. Kenya is Africa/Nairobi, not Africa/Kenya.
OFFICE_TIMEZONE="Africa/Nairobi"

# --- Browser push notifications ("your guest has arrived") ---
# Generate once with: npx web-push generate-vapid-keys
# Public key is safe to expose. Keep the private key secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
# Contact for push services. Use a real mailbox you own.
VAPID_SUBJECT="mailto:desk@yourdomain.com"
